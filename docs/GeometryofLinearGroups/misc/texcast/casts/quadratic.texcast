{"version": 1, "title": "The quadratic formula", "morph": 0.8, "hold": 3}
[0, "caption", "Start with any quadratic."]
[0, "show", "ax^2 + bx + c = 0"]
[2.6, "caption", "Divide through by $a$."]
[0, "show", "x^2 + \\frac{b}{a}x + \\frac{c}{a} = 0"]
[2.6, "caption", "Move the constant to the right."]
[0, "show", "x^2 + \\frac{b}{a}x = -\\frac{c}{a}"]
[2.6, "caption", "Add $\\left(\\tfrac{b}{2a}\\right)^2$ to both sides."]
[0, "show", "x^2 + \\frac{b}{a}x + \\blue{\\frac{b^2}{4a^2}} = \\blue{\\frac{b^2}{4a^2}} - \\frac{c}{a}"]
[2.8, "caption", "Now the left side is a perfect square."]
[0, "show", "\\left(x + \\blue{\\frac{b}{2a}}\\right)^2 = \\frac{b^2 - 4ac}{4a^2}"]
[2.8, "caption", "Take square roots."]
[0, "show", "x + \\frac{b}{2a} = \\pm\\frac{\\sqrt{b^2 - 4ac}}{2a}"]
[2.8, "caption", "Solve for $x$."]
[0, "show", "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"]
