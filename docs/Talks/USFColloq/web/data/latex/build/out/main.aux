\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces A Schottky group. The discs have radius $1$ and centers $\pm 1.45$ and $\pm 1.45i$, and \eqref  {eq:pairing} gives $a(z) = 1.45 - 1/(z + 1.45)$ and $b(z) = 1.45i + 1/(z + 1.45i)$. Inside each $D_s$ are the discs $w(D_t)$ for the reduced words $wt$ of length $2$ to $5$ that begin with $s$, darker for longer words. Here $aD_t$ means $a(D_t)$.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:schottky}{{4}{7}{A Schottky group. The discs have radius $1$ and centers $\pm 1.45$ and $\pm 1.45i$, and \eqref {eq:pairing} gives $a(z) = 1.45 - 1/(z + 1.45)$ and $b(z) = 1.45i + 1/(z + 1.45i)$. Inside each $D_s$ are the discs $w(D_t)$ for the reduced words $wt$ of length $2$ to $5$ that begin with $s$, darker for longer words. Here $aD_t$ means $a(D_t)$}{figure.4}{}}
